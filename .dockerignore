# 依赖（边车依赖在镜像内安装，不随上下文拷贝）
**/node_modules/

# 运行时状态 / 凭证（持久化卷提供，不进镜像层）
.port
.session.json
.netease-device.json
*.auth-*
*.log
server.err.log

# 截图 / 本地留档 / 备份
shots/
_*.json
*.bak
*.bak-*
*.bak2

# 打包产物与版本库元数据
dist/
.git/
.github/
.scratch-*/
.claude/
__pycache__/

# --- 构建上下文瘦身（以下内容 Dockerfile 都不 COPY，没必要传给 daemon）---
desktop/
build/
docker/
dist/
release.mjs
start.cmd
package-lock.json
*.md
shots/
public/site/download/

# 旧版移动端遗留（零引用，已归档）
public/_legacy/

# 官网静态页（应用零引用，13MB，不进镜像）
public/site/

